# OPCIONAL — este não está instalado. Serve para o painel subir junto com o WSL,
# em vez de depender de você abrir um terminal e rodar `bun run panel`.
#
#   cp infra/remote/focus-painel.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now focus-painel
#
# Com ele ligado, PC ligado já basta para o tablet enxergar o painel. Sem ele,
# o endereço público responde 502 até você iniciar o painel na mão.
#
# A porta não aparece aqui de propósito: o bun lê o .env do WorkingDirectory, e
# lá está FOCUS_PANEL_PORT=17788 — o mesmo número que o túnel usa. Um lugar só
# para a porta é o que impede os dois lados de saírem de sincronia.

[Unit]
Description=Painel do focus-scrap
After=network-online.target

[Service]
# O projeto mora em /mnt/d, que NÃO é uma unidade do Windows: é um SSD físico
# anexado ao WSL por um script externo no logon (a mesma tarefa que serve o
# ia-monitor e o ensinantes-digitais). Há uma corrida ali — o WSL acorda, o
# systemd começa a subir isto, e só depois o disco é montado lá dentro. Às
# vezes o script de montagem falha de vez (ex: WSL subiu sem o Windows ter
# terminado de inicializar o USB) e o disco nunca aparece sozinho.
#
# Por isso o traço em `WorkingDirectory=-`: sem ele, o systemd falha antes de
# executar qualquer coisa quando o caminho ainda não existe. E por isso o
# ExecStart espera o ponto de montagem em loop, com pausa de 1 min entre
# tentativas, antes de trocar de diretório — o `cd` é necessário porque é do
# diretório de trabalho que o bun lê o `.env`.
WorkingDirectory=-/mnt/d/Chico/focus-scrap
ExecStart=/bin/sh -c 'while ! mountpoint -q /mnt/d; do echo "/mnt/d ainda nao montado, tentando de novo em 1min"; sleep 60; done; \
  cd /mnt/d/Chico/focus-scrap || { echo "/mnt/d montou mas o projeto nao esta la"; exit 1; }; \
  exec /home/chico/.bun/bin/bun run src/cli.ts panel'
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
