{
  "name": "focus-scrap",
  "version": "0.1.0",
  "private": true,
  "description": "Captura os materiais de estudo da Faculdade Focus (vídeos, slides, ebooks), transcreve e legenda, e organiza no disco de estudo.",
  "type": "module",
  "scripts": {
    "login": "bun run src/cli.ts login",
    "scrape": "bun run src/cli.ts scrape",
    "scan": "bun run src/cli.ts scan",
    "panel": "bun run src/cli.ts panel",
    "status": "bun run src/cli.ts status",
    "requeue": "bun run src/cli.ts requeue",
    "explore": "bun run src/cli.ts explore",
    "media": "uv run python -m focus.worker",
    "media:no-gpu": "uv run python -m focus.worker --no-transcribe",
    "verify": "uv run python -m focus.verify",
    "assistir": "bun run src/cli.ts assistir",
    "faltando": "bun run src/cli.ts faltando",
    "setup": "bun install && bun run setup:browser && bun run setup:py",
    "setup:browser": "bunx playwright install chromium",
    "setup:py": "uv sync",
    "setup:py:gpu": "uv sync --extra gpu",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "playwright": "^1.58.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
