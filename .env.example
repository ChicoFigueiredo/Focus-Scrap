# Copie para .env e preencha. O .env real é ignorado pelo git.

# --- Alvos --------------------------------------------------------------
# Dois sistemas, sessões independentes, MESMAS credenciais (não há SSO):
#   portal → matrículas e dados do aluno
#   ava    → Moodle, onde estão os materiais
FOCUS_BASE_URL=https://faculdadefocus.com.br
FOCUS_AVA_URL=https://ava.faculdadefocus.edu.br
FOCUS_USER=
FOCUS_PASSWORD=

# --- Agente (gpt-4o-mini via OpenRouter) --------------------------------
OPENROUTER_API_KEY=
FOCUS_AGENT_MODEL=openai/gpt-4o-mini

# --- Download / transcrição (opcionais; defaults no config) -------------
# FOCUS_RATE_LIMIT=3M
# FOCUS_DELAY=20
# FOCUS_WHISPER_MODEL=large-v3
# FOCUS_WHISPER_COMPUTE=float16
# FOCUS_WHISPER_BATCH=16

# --- Painel -------------------------------------------------------------
# FOCUS_PANEL_PORT=7788
